# Optional settings for docker compose.
# Copy this file to ".env" (same folder) and change the values.
# Without a .env file, the development defaults in docker-compose.yml are used.

# Port on your PC where the app is served: http://localhost:8088
WEB_PORT=8088

# Password for the Postgres "notedeck" user.
# Note: Postgres only reads this when it creates a NEW database (an empty
# volume). To change it later, run "docker compose down -v" (deletes data).
POSTGRES_PASSWORD=change-me-to-something-long

# Secret used to sign login sessions. Any long random string.
# Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
